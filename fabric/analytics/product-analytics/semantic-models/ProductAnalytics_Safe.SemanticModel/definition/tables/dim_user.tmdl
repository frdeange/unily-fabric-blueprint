table dim_user

	column tenant_id
		dataType: string
		summarizeBy: none
		sourceColumn: tenant_id

	column user_key
		dataType: string
		isKey
		summarizeBy: none
		sourceColumn: user_key

	column first_seen_date
		dataType: dateTime
		formatString: yyyy-mm-dd
		summarizeBy: none
		sourceColumn: first_seen_date

	column last_seen_date
		dataType: dateTime
		formatString: yyyy-mm-dd
		summarizeBy: none
		sourceColumn: last_seen_date

	column event_count
		dataType: int64
		summarizeBy: none
		sourceColumn: event_count

	partition dim_user = entity
		mode: directLake
		source
			entityName: dim_user
			schemaName: product
			expressionSource: 'DirectLake - Gold'
